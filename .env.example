# Copy to .env and fill in the values - NEVER commit .env with real secrets

# ===== ACTIVE AI ADAPTER =====
# Use "hermes" for multi-model routing or "ollama" for the retained local model.
AI_PROVIDER=hermes

# ===== WINDOWS HOST HERMES ROUTER =====
HERMES_ROUTER_URL=http://host.docker.internal:8765# Allows a primary Hermes attempt plus a fallback attempt.
HERMES_ROUTER_TIMEOUT=620
# The following two values are read by the Windows host process.
HERMES_COMMAND_TIMEOUT=300
# Project Builder worker subprocess timeout; normal chat still uses HERMES_COMMAND_TIMEOUT.
HERMES_PROJECT_WORKER_TIMEOUT=900
HERMES_ROUTER_PORT=8765
# Shared private token, at least 32 characters; required only for Project Builder.
PROJECT_BUILDER_TOKEN=
# Optional: full path to Python in your Windows Hermes installation.
# Default: %LOCALAPPDATA%/hermes/hermes-agent/venv/Scripts/python.exe
HERMES_PYTHON=

# ===== LOCAL OLLAMA CONFIGURATION =====
# The backend runs in Docker. Ollama runs on the Windows host.
# Inside the container, use host.docker.internal to reach the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# ===== DATABASE CONFIGURATION =====
POSTGRES_USER=assistant
POSTGRES_PASSWORD=changeme
POSTGRES_DB=assistantdb
POSTGRES_HOST=db
POSTGRES_PORT=5432
BACKEND_PORT=8000

# ===== HISTORICAL: OPENAI (PREVIOUS IMPLEMENTATION) =====
# The project originally used OpenAI API. This has been replaced with local Ollama.
# OPENAI_API_KEY= (no longer required)
