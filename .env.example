# Copy to .env for a NEW installation; preserve an existing .env.
# Replace secret placeholders privately. Never commit the real .env.

# ===== ACTIVE AI ADAPTER =====
# Core chat, generation, and repair use Ollama.
# The local Python helper handles project writes, validation, and repair.
AI_PROVIDER=ollama

# ===== WINDOWS HOST PROJECT HELPER =====
# Local helper: 8766. Optional legacy online router: 8765.
HERMES_ROUTER_URL=http://host.docker.internal:8766
HERMES_ROUTER_TIMEOUT=620
# The following two values are read by the Windows host process.
HERMES_COMMAND_TIMEOUT=300
# Project Builder worker subprocess timeout; normal chat still uses HERMES_COMMAND_TIMEOUT.
HERMES_PROJECT_WORKER_TIMEOUT=900
# Used only by hermes_service.py; offline_host.py always uses 8766.
HERMES_ROUTER_PORT=8765
# Random private token, at least 32 characters, shared by backend and host.
# Required for project build, validation, and repair. Set privately in .env.
PROJECT_BUILDER_TOKEN=
CHAT_AI_ENGINE=ollama
PROJECT_AI_ENGINE=ollama
# Optional absolute native codex.exe path if automatic discovery fails.
PROJECT_CODEX_EXECUTABLE=
# Optional legacy Hermes project engine: full path to its Python installation.
# Default: %LOCALAPPDATA%/hermes/hermes-agent/venv/Scripts/python.exe
HERMES_PYTHON=

# ===== LOCAL OLLAMA CONFIGURATION =====
# The backend runs in Docker. Ollama runs on the Windows host.
# Inside the container, use host.docker.internal to reach the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Optional comma-separated local models. Empty uses the built-in random local pool.
OLLAMA_MODELS=
# Host helper uses loopback, separately from Docker backend addressing.
OLLAMA_HOST_BASE_URL=http://127.0.0.1:11434

# ===== DATABASE CONFIGURATION =====
POSTGRES_USER=assistant
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_DATABASE_PASSWORD
POSTGRES_DB=assistantdb
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Published Web UI port; the backend listens on port 8000 inside Docker.
BACKEND_PORT=8000

# Changing these credentials does not update an already-initialized DB volume.
# The host dispatcher connects to 127.0.0.1:POSTGRES_PORT in code.
# Codex uses its existing CLI login; local Ollama needs no provider API key.
# The Hermes gateway has separate configuration in its /opt/data mount.
# This .env does not automatically authenticate the gateway container.
